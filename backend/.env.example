# Lucy backend environment template.
# Copy this file to .env and replace all CHANGE_ME_* placeholders with real values before starting.
# Never commit real secrets or the active .env file.

# Application
APP_NAME=Lucy C2
DEBUG=false
ENVIRONMENT=production

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite:///./lucy.db

# JWT secrets: generate 64-character hex strings (32 random bytes), e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_64CHAR_HEX_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64CHAR_HEX_JWT_REFRESH_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Master key for credential encryption: 64-character hex string
MASTER_KEY=CHANGE_ME_64CHAR_HEX_MASTER_KEY

CORS_ORIGINS=["http://localhost:3000"]

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Admin seed user. ADMIN_USERNAME must NOT be "admin".
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Chat settings
CHAT_HISTORY_LIMIT=500
# CHAT_LOCAL_LLM_URL=http://localhost:11434/api/generate
STEALTH_PACK_DEFAULT=false

LOG_LEVEL=INFO
